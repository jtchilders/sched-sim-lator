# Python
__pycache__/
*.pyc
.venv/
venv/

# Data caches (regenerated from DB)
*.pkl
*.trace_cache.pkl
*.fitted_cache.pkl

# Local DB (never commit data)
*.db
*.sqlite

# Large generated artifacts (tracked via results/MANIFEST.md instead)
results/**/*.png
results/**/*.csv
slides.html

# EXCEPTION: modeling figures embedded in MODELING.md ARE tracked (docs/figures/).
# These are small, reproducible via scripts/make_modeling_figures.py, and needed
# to render the modeling documentation on GitHub.
!docs/figures/*.png
data/*.npz
results/example_scan/
